# --- Supabase (Project Settings → API) ---------------------------------------
# Public values: safe in the browser. Access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public base URL of the app (used for invitation links and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---------------------
# Everything below is optional. Each missing value disables only its feature,
# and the app shows a clear "not connected" state instead.

# AI assistant, receipts, bills, documents, recipe/plant recognition, written brief.
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Encrypts integration tokens (Home Assistant, Google) before they are stored.
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# Google Calendar + Gmail bill import (Google Cloud Console → OAuth client, type "Web").
# Authorized redirect URI: <site>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (browser notifications). Generate with: npx web-push generate-vapid-keys
# Until set, notifications appear inside the app only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

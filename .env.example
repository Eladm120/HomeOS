# --- Supabase (Project Settings → API) ---------------------------------------
# Public values: safe in the browser. Access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public base URL of the app (used for invitation links and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---------------------
# Not used by Phase 1. Reserved for background jobs in later phases.
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
